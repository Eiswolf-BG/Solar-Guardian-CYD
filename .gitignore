.pio/
.vscode/
*.o
*.elf
*.bin
!/versions/**/*.bin
.DS_Store

# Zugangsdaten/geraetespezifischer Zustand - nie committen
secrets.h
config.json
yield.json
years.json
days.csv
History/

# Foto-Originale (unverkleinert, mit EXIF) - nur die verkleinerten
# Kopien in docs/images werden committet, siehe README-Workflow.
/images/

# Native Testumgebung (Auftrag "Tests am Rechner statt am Geraet") - rein
# lokal, nie committen.
/test/

# Mehrtaegige Portal-Messung (Auftrag) - rein lokales Diagnosewerkzeug,
# bleibt unversioniert. Der Aufruf in main.cpp ist entsprechend per
# #ifdef PORTAL_DAY_PROBE (siehe config.h) abgesichert, damit ein
# frischer Checkout ohne diese Dateien trotzdem baut.
src/portal_day_probe.h
src/portal_day_probe.cpp

# Lokale Kopien/Sicherungen der SD-Karte - koennen echte Zugangsdaten
# enthalten, nie committen. Greift strukturell (jeder Ordner, der direkt
# eine SolarGuardian- oder SolarHistory-Unterordner enthaelt, egal wie
# der aeussere Ordner selbst heisst - z.B. manuell angelegte, beliebig
# benannte Backup-/Schnappschuss-Ordner), nicht an einen bestimmten Namen
# oder Datum gebunden.
/SD-Backup/
/SolarGuardian/
/SolarHistory/
/*/SolarGuardian/
/*/SolarHistory/
